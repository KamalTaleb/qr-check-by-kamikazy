{
  "manifest_version": 3,
  "name": "QR Check by Kamikazy",
  "version": "1.0.0",
  "description": "Paste a link, get a QR code. Download it as SVG (vector) or PNG.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Check by Kamikazy",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab"]
}
